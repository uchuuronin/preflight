# Names only. Real values live in GitHub Actions secrets (repo Settings > Secrets and variables > Actions)
# and, for code running on Modal, in Modal secrets. Never commit a filled-in copy of this file.

# Modal (GitHub Actions only; agents never hold these)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Meta Model API (Muse Spark, Muse Code, Muse Glimmer). Base URL from the Meta dashboard's API page.
META_API_KEY=
META_API_BASE=

# Baseten (Muse Spark Open)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# AMD Developer Cloud droplet (GitHub Actions only)
AMD_SSH_KEY=
# Optional: an API token from the AMD cloud panel, so a workflow can destroy the droplet when done
DO_API_TOKEN=
