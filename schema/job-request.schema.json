{
	"$defs": {
		"Constraints": {
			"additionalProperties": false,
			"properties": {
				"budget_usd": {
					"anyOf": [
						{
							"minimum": 0,
							"type": "number"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"title": "Budget Usd"
				},
				"deadline": {
					"anyOf": [
						{
							"format": "date-time",
							"type": "string"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"title": "Deadline"
				},
				"gpu_types": {
					"description": "Allowed GPU names; empty means any",
					"items": {
						"maxLength": 64,
						"minLength": 1,
						"type": "string"
					},
					"title": "Gpu Types",
					"type": "array"
				},
				"max_gpus": {
					"anyOf": [
						{
							"minimum": 1,
							"type": "integer"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"title": "Max Gpus"
				},
				"quota": {
					"anyOf": [
						{
							"$ref": "#/$defs/Quota"
						},
						{
							"type": "null"
						}
					],
					"default": null
				},
				"wall_time_cap_s": {
					"anyOf": [
						{
							"exclusiveMinimum": 0,
							"type": "number"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"description": "Scheduler limit per job, e.g. Slurm",
					"title": "Wall Time Cap S"
				},
				"preemption": {
					"$ref": "#/$defs/PreemptionRule"
				}
			},
			"title": "Constraints",
			"type": "object"
		},
		"PreemptionRule": {
			"additionalProperties": false,
			"properties": {
				"kind": {
					"default": "none",
					"enum": [
						"none",
						"poisson",
						"policy"
					],
					"title": "Kind",
					"type": "string"
				},
				"mtti_s": {
					"anyOf": [
						{
							"type": "number"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"description": "Mean time to interrupt, for kind=poisson",
					"title": "Mtti S"
				},
				"policy": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"description": "The cluster's rule in words, for kind=policy",
					"title": "Policy"
				},
				"grace_s": {
					"anyOf": [
						{
							"type": "number"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"title": "Grace S"
				}
			},
			"title": "PreemptionRule",
			"type": "object"
		},
		"Quota": {
			"additionalProperties": false,
			"properties": {
				"disk_bytes": {
					"anyOf": [
						{
							"type": "integer"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"title": "Disk Bytes"
				},
				"gpu_hours": {
					"anyOf": [
						{
							"type": "number"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"title": "Gpu Hours"
				},
				"api_usd": {
					"anyOf": [
						{
							"type": "number"
						},
						{
							"type": "null"
						}
					],
					"default": null,
					"title": "Api Usd"
				}
			},
			"title": "Quota",
			"type": "object"
		}
	},
	"additionalProperties": false,
	"description": "Body of POST /v1/jobs (validated by C, executed by A).",
	"properties": {
		"source": {
			"additionalProperties": true,
			"description": "A Source: sample, repo, upload, notebook or template",
			"title": "Source",
			"type": "object"
		},
		"lens": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"description": "Optional hint; the script map decides",
			"title": "Lens"
		},
		"objective": {
			"anyOf": [
				{
					"additionalProperties": true,
					"type": "object"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"title": "Objective"
		},
		"constraints": {
			"anyOf": [
				{
					"$ref": "#/$defs/Constraints"
				},
				{
					"type": "null"
				}
			],
			"default": null
		},
		"gpu": {
			"anyOf": [
				{
					"maxLength": 64,
					"minLength": 1,
					"type": "string"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"description": "Requested GPU class; admission control may change it",
			"title": "Gpu"
		},
		"description": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"description": "The visitor's use case, for the guide",
			"title": "Description"
		},
		"mode": {
			"default": "plan",
			"description": "plan: map and probe a script (default). probe: one probe at `knobs`. verify: a short fixed-seed run of `knobs` against the record's current settings. sample_more: `tasks` more agent tasks. All but plan take a record source.",
			"enum": [
				"plan",
				"probe",
				"verify",
				"sample_more"
			],
			"title": "Mode",
			"type": "string"
		},
		"knobs": {
			"anyOf": [
				{
					"additionalProperties": {
						"anyOf": [
							{
								"type": "boolean"
							},
							{
								"type": "integer"
							},
							{
								"type": "number"
							},
							{
								"type": "string"
							}
						]
					},
					"maxProperties": 64,
					"type": "object"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"description": "probe and verify: the full setting to run at",
			"title": "Knobs"
		},
		"tasks": {
			"anyOf": [
				{
					"maximum": 50,
					"minimum": 1,
					"type": "integer"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"description": "sample_more: how many more tasks",
			"title": "Tasks"
		},
		"purpose": {
			"anyOf": [
				{
					"maxLength": 64,
					"pattern": "^[a-z][a-z0-9_.]*$",
					"type": "string"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"description": "Who asked, for the logbook, e.g. guide.run_probe",
			"title": "Purpose"
		}
	},
	"required": [
		"source"
	],
	"title": "JobRequest",
	"type": "object",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://preflight.dev/schema/0.3.0/JobRequest"
}
